{
  "expo": {
    "name": "Ingat Tagihan",
    "slug": "pengingat-tagihan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pengingat-tagihan",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F3F8FF"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#49108B"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan Ingat Tagihan memilih foto bukti untuk catatan hutang dan pembayaran.",
          "cameraPermission": "Izinkan Ingat Tagihan mengambil foto bukti untuk catatan hutang dan pembayaran."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
